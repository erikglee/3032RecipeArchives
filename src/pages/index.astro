---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const recipes = (await getCollection('recipes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = recipes.slice(0, 3);
const tags = Array.from(new Set(recipes.flatMap((recipe) => recipe.data.tags))).sort();
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="3032 Recipe Archives"
  description="A personal archive of recipes worth returning to."
>
  <p class="archive-intro">A mix of homemade, ChatGPT-curated, and favorite published recipes.</p>

  <section class="section-heading">
    <div>
      <p class="eyebrow">Recently filed</p>
      <h2>Latest recipes</h2>
    </div>
    <a class="text-link" href={`${base}recipes/`}>View all</a>
  </section>

  <div class="recipe-grid">
    {featured.map((recipe) => (
      <article class="recipe-card">
        <p class="card-meta">{recipe.data.meal} · {recipe.data.prepTime} prep</p>
        <h3><a href={`${base}recipes/${recipe.slug}/`}>{recipe.data.title}</a></h3>
        <p>{recipe.data.description}</p>
        <div class="tag-list">
          {recipe.data.tags.slice(0, 3).map((tag) => <a href={`${base}tags/${tag}/`}>{tag}</a>)}
        </div>
      </article>
    ))}
  </div>

  <section class="tag-cloud" aria-labelledby="tags-heading">
    <p class="eyebrow">Browse by mood</p>
    <h2 id="tags-heading">Tags</h2>
    <div class="tag-list large">
      {tags.map((tag) => <a href={`${base}tags/${tag}/`}>{tag}</a>)}
    </div>
  </section>
</BaseLayout>
