---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  const tags = Array.from(new Set(recipes.flatMap((recipe) => recipe.data.tags)));

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      recipes: recipes.filter((recipe) => recipe.data.tags.includes(tag)),
    },
  }));
}

const { tag, recipes } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`Recipes tagged ${tag}`} description={`Recipes tagged ${tag}.`}>
  <section class="page-title">
    <p class="eyebrow">Tag</p>
    <h1>{tag}</h1>
    <p>{recipes.length} recipes filed here.</p>
  </section>

  <div class="recipe-grid">
    {recipes.map((recipe) => (
      <article class="recipe-card">
        <p class="card-meta">{recipe.data.meal} · {recipe.data.prepTime} prep</p>
        <h2><a href={`${base}recipes/${recipe.slug}/`}>{recipe.data.title}</a></h2>
        <p>{recipe.data.description}</p>
      </article>
    ))}
  </div>
</BaseLayout>
