---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allRecipes = await getCollection('recipes');
  const categories = {
    soups: {
      title: 'Soups',
      matches: (recipe: CollectionEntry<'recipes'>) => recipe.data.tags.includes('soup'),
    },
    'dinner-entrees': {
      title: 'Dinner Entrees',
      matches: (recipe: CollectionEntry<'recipes'>) => recipe.data.meal === 'dinner' && !recipe.data.tags.includes('soup'),
    },
    breads: {
      title: 'Breads',
      matches: (recipe: CollectionEntry<'recipes'>) => recipe.data.meal === 'bread',
    },
    sides: {
      title: 'Sides',
      matches: (recipe: CollectionEntry<'recipes'>) => recipe.data.meal === 'side',
    },
    desserts: {
      title: 'Desserts',
      matches: (recipe: CollectionEntry<'recipes'>) => recipe.data.meal === 'dessert',
    },
    'fermented-foods': {
      title: 'Ferments and Pickles',
      matches: (recipe: CollectionEntry<'recipes'>) => recipe.data.tags.includes('fermented') || recipe.data.tags.includes('pickles'),
    },
  };

  return Object.entries(categories).map(([category, details]) => ({
    params: { category },
    props: {
      category: details,
      recipes: allRecipes
        .filter(details.matches)
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { category, recipes } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={category.title} description={`${category.title} recipes.`}>
  <section class="page-title">
    <div>
      <p class="eyebrow">Recipe collection</p>
      <h1>{category.title}</h1>
    </div>
  </section>

  <div class="recipe-grid">
    {recipes.map((recipe) => (
      <article class="recipe-card">
        <p class="card-meta">{recipe.data.meal} · {recipe.data.prepTime} prep</p>
        <h2><a href={`${base}recipes/${recipe.slug}/`}>{recipe.data.title}</a></h2>
        <p>{recipe.data.description}</p>
        <div class="tag-list">
          {recipe.data.tags.map((tag) => <a href={`${base}tags/${tag}/`}>{tag}</a>)}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
