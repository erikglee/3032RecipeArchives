---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const base = import.meta.env.BASE_URL;
const isSourceRecipe = Boolean(recipe.data.sourceUrl);
---

<BaseLayout title={recipe.data.title} description={recipe.data.description}>
  <article class="recipe-detail">
    <header class="recipe-header">
      <a class="text-link" href={`${base}recipes/`}>Back to recipes</a>
      <p class="eyebrow">{recipe.data.meal}{recipe.data.cuisine ? ` · ${recipe.data.cuisine}` : ''}</p>
      {recipe.data.familyRecipe && <p class="family-label">Family recipe</p>}
      <h1>{recipe.data.title}</h1>
      <p>{recipe.data.description}</p>
      {recipe.data.developedWith && (
        <p class="recipe-attribution">
          Recipe developed with{' '}
          {recipe.data.developmentUrl ? (
            <a href={recipe.data.developmentUrl}>{recipe.data.developedWith}</a>
          ) : recipe.data.developedWith}
          .
        </p>
      )}
      {recipe.data.image && (
        <img
          class="recipe-photo"
          src={`${base}${recipe.data.image}`}
          alt={`Finished ${recipe.data.title}`}
        />
      )}
      {!isSourceRecipe && (
        <dl class="recipe-stats">
          <div>
            <dt>Prep</dt>
            <dd>{recipe.data.prepTime}</dd>
          </div>
          <div>
            <dt>Cook</dt>
            <dd>{recipe.data.cookTime}</dd>
          </div>
          <div>
            <dt>Serves</dt>
            <dd>{recipe.data.servings}</dd>
          </div>
        </dl>
      )}
    </header>

    {isSourceRecipe ? (
      <section
        class:list={['source-recipe', { 'source-recipe--single': recipe.data.modifications.length === 0 }]}
        aria-label="Original recipe and personal modifications"
      >
        <div>
          <p class="eyebrow">Original recipe</p>
          <h2><a href={recipe.data.sourceUrl}>{recipe.data.sourceName}</a></h2>
          <p>Follow the original recipe for the full ingredients and method.</p>
        </div>
        {recipe.data.modifications.length > 0 && (
          <div>
            <p class="eyebrow">My modifications</p>
            <ul>
              {recipe.data.modifications.map((modification) => <li>{modification}</li>)}
            </ul>
          </div>
        )}
      </section>
    ) : (
      <div class="recipe-columns">
        <aside class="ingredients">
          <h2>Ingredients</h2>
          <ul>
            {recipe.data.ingredients.map((ingredient) => <li>{ingredient}</li>)}
          </ul>
        </aside>
        <div class="instructions">
          <Content />
        </div>
      </div>
    )}
  </article>
</BaseLayout>
